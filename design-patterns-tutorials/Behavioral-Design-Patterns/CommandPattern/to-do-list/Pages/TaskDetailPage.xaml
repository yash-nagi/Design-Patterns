<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:to_do_list.Converters"
             x:Class="to_do_list.TaskDetailPage"
             BackgroundColor="#F7F6FC"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CompletedTextConverter
                x:Key="CompletedTextConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid Padding="24,35,24,25"
          RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,5,0,25">

            <Button Text="‹"
                    FontSize="30"
                    BackgroundColor="Transparent"
                    TextColor="#201B32"
                    WidthRequest="35"
                    Padding="0"
                    Command="{Binding BackCommand}"/>

            <Button Grid.Column="2"
                    Text="✎"
                    FontSize="23"
                    BackgroundColor="Transparent"
                    TextColor="#201B32"
                    WidthRequest="40"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                    CommandParameter="{Binding TaskItem}"/>

        </Grid>


        <!-- Details -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22">

                <!-- Task Title -->
                <VerticalStackLayout Spacing="12">

                    <Label Text="{Binding TaskItem.Title}"
                           FontSize="29"
                           FontAttributes="Bold"
                           TextColor="#201B32"/>

                    <HorizontalStackLayout Spacing="10">

                        <Border BackgroundColor="White"
                                Stroke="#E5E1EF"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,7">

                            <Label Text="{Binding TaskItem.Priority}"
                                   FontSize="13"
                                   TextColor="#B42318"/>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="#E5E1EF"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,7">

                            <Label Text="{Binding TaskItem.Category}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#201B32"/>
                        </Border>

                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Due Date and Reminder -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14">

                    <Border BackgroundColor="White"
                            Stroke="#E5E1EF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 17"
                            Padding="16">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Due"
                                   FontSize="13"
                                   TextColor="#77728B"/>

                            <Label Text="{Binding TaskItem.DueDateText}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#201B32"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E1EF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 17"
                            Padding="16">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Reminder"
                                   FontSize="13"
                                   TextColor="#77728B"/>

                            <Label Text="{Binding TaskItem.ReminderText}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#201B32"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Notes -->
                <Border BackgroundColor="White"
                        Stroke="#E5E1EF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 17"
                        Padding="18">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Notes"
                               FontSize="14"
                               TextColor="#77728B"/>

                        <Label Text="{Binding TaskItem.Notes}"
                               FontSize="16"
                               TextColor="#201B32"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Subtasks -->
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Subtasks"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#201B32"/>

                        <Label Grid.Column="1"
                               Text="{Binding SubtaskProgress}"
                               FontSize="13"
                               TextColor="#77728B"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Border BackgroundColor="White"
                            Stroke="#E5E1EF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 17"
                            Padding="10">

                        <CollectionView ItemsSource="{Binding TaskItem.Subtasks}"
                                        SelectionMode="None">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12"
                                          Padding="8,12">

                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  Color="#512BD4"
                                                  VerticalOptions="Center"/>

                                        <Label Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="15"
                                               TextColor="#201B32"
                                               VerticalOptions="Center"
                                               TextDecorations="{Binding IsCompleted,
                       Converter={StaticResource CompletedTextConverter}}"/>

                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- Delete button -->
        <Button Grid.Row="2"
                Text="Delete Task"
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding IsEditMode}"
                BackgroundColor="#DC2626"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="35"
                HeightRequest="55"
                Margin="0,10,0,0"/>

    </Grid>
</ContentPage>
